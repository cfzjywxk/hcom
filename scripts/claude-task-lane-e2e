#!/bin/bash
# Serial opt-in runner for one bounded real Claude task-lane/lifecycle scenario.
#
# Usage:
#   CLAUDE_TEST_MODEL=haiku CLAUDE_TEST_EFFORT=medium \
#     scripts/claude-task-lane-e2e <scenario>
#
# This script never sets or repairs the required proxy variables. Each Rust
# scenario validates the raw inherited environment before any Claude spawn.
set -euo pipefail

if [ "${CLAUDE_TEST_MODEL-}" != "haiku" ]; then
  printf 'CLAUDE_TEST_MODEL must be explicitly set to haiku\n' >&2
  exit 64
fi
if [ "${CLAUDE_TEST_EFFORT-}" != "medium" ]; then
  printf 'CLAUDE_TEST_EFFORT must be explicitly set to medium\n' >&2
  exit 64
fi

scenario=${1-}
if [ -z "$scenario" ]; then
  printf '%s\n' \
    'usage: scripts/claude-task-lane-e2e <mixed|developer-resume|claude-pair|exhaustion|abnormal-exit|nested|cancel|timeout|parent-death|native-contract|all>' \
    >&2
  exit 64
fi

script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
repo_root=$(CDPATH= cd -- "$script_dir/.." && pwd)
cd "$repo_root"

cargo build --quiet --locked --bin hcom
target_dir=${CARGO_TARGET_DIR:-target}
case "$target_dir" in
  /*) ;;
  *) target_dir="$repo_root/$target_dir" ;;
esac
real_hcom=$(readlink -f -- "$target_dir/debug/hcom")
if [ ! -x "$real_hcom" ]; then
  printf 'fresh hcom Guardian binary is missing: %s\n' "$real_hcom" >&2
  exit 1
fi

run_lib() {
  local name=$1
  HCOM_REAL_E2E_HCOM_BIN="$real_hcom" \
  cargo test --locked --lib "$name" -- --ignored --nocapture --test-threads=1
}

run_contract() {
  local name=$1
  cargo test --locked --test real_claude_contract "$name" \
    -- --ignored --nocapture --test-threads=1
}

run_scenario() {
  case "$1" in
    mixed)
      run_lib real_claude_default_mixed_review_loop_and_reviewer_exact_resume
      ;;
    developer-resume)
      run_lib real_claude_developer_codex_reviewer_exact_resume
      ;;
    claude-pair)
      run_lib real_claude_pair_uses_fresh_cross_task_sessions
      ;;
    exhaustion)
      run_lib real_claude_review_exhaustion_advances_to_next_task
      ;;
    abnormal-exit)
      run_lib real_killed_claude_developer_never_routes_a_partial_final
      ;;
    nested)
      run_lib real_claude_nested_double_fork_is_reaped_and_success_is_not_routed
      ;;
    cancel)
      run_lib real_claude_cancel_reaps_escaped_descendants
      ;;
    timeout)
      run_contract real_claude_timeout_reaps_escaped_descendants
      ;;
    parent-death)
      run_contract real_claude_parent_death_reaps_escaped_descendants
      ;;
    native-contract)
      run_contract real_claude_native_contract_create_and_exact_resume
      ;;
    *)
      printf 'unknown Claude E2E scenario: %s\n' "$1" >&2
      exit 64
      ;;
  esac
}

if [ "$scenario" = "all" ]; then
  for selected in \
    native-contract \
    mixed \
    developer-resume \
    claude-pair \
    exhaustion \
    abnormal-exit \
    nested \
    cancel \
    timeout \
    parent-death
  do
    printf '\n== Claude E2E: %s ==\n' "$selected"
    run_scenario "$selected"
  done
else
  run_scenario "$scenario"
fi
