#!/bin/bash
# Contract smokes for the Codex exec worker seam.
#
# These probe the *external* behavior the lane depends on, against the native
# Codex selected from PATH. Unit tests cannot cover them: a fake CLI would just
# reproduce whatever hcom already believes. Run before every release, and again
# after material Codex CLI behavior changes.
#
#   scripts/codex-exec-contract-smokes
#
# Requires: codex on PATH, usable native authentication, and network
# access. The disposable CODEX_HOME used here prevents a smoke from touching
# the operator's real session history while exercising the same native config
# loader and process shape as production.
set -uo pipefail

CODEX=${CODEX:-codex}
MODEL=${SMOKE_MODEL:-gpt-5.3-codex-spark}
EFFORT=${SMOKE_EFFORT:-medium}

WORK=$(mktemp -d -t hcom-exec-smokes.XXXXXX)
trap 'rm -rf -- "$WORK"' EXIT
pass=0
fail=0

report() { # name, ok(0/1), detail
  if [ "$2" -eq 0 ]; then
    printf 'PASS  %-46s %s\n' "$1" "${3:-}"
    pass=$((pass + 1))
  else
    printf 'FAIL  %-46s %s\n' "$1" "${3:-}"
    fail=$((fail + 1))
  fi
}

# Create turns carry --cd; resume turns do not and
# instead inherit the *process* working directory, so run from `cwd` either way.
native_shape() { # cwd, out_file, extra args...
  local cwd="$1" out="$2"
  shift 2
  local cd_args=(--cd "$cwd")
  for argument in "$@"; do
    [ "$argument" = "resume" ] && cd_args=()
  done
  cd "$cwd" || return 1
  timeout "${SMOKE_TIMEOUT:-280}" "$CODEX" exec \
    --sandbox danger-full-access \
    --skip-git-repo-check \
    "$@" \
    --json \
    --model "$MODEL" \
    --config "model_reasoning_effort=\"$EFFORT\"" \
    --config 'approval_policy="never"' \
    "${cd_args[@]}" \
    --output-last-message "$out" \
    -
}

# --- C0: native command availability ----------------------------------------
if command -v "$CODEX" >/dev/null 2>&1; then
  report "C0 native codex available" 0 "$(command -v "$CODEX")"
else
  report "C0 native codex available" 1 "$CODEX"
  exit 1
fi

# --- C1: create turn writes the final message -------------------------------
mkdir -p "$WORK/c1/project" "$WORK/c1/home"
export CODEX_HOME="$WORK/c1/home"
cp ~/.codex/auth.json "$CODEX_HOME/auth.json" 2>/dev/null
printf 'Reply with a final message of exactly: SMOKE-C1' \
  | native_shape "$WORK/c1/project" "$WORK/c1/last.md" \
  > "$WORK/c1/events.jsonl" 2>"$WORK/c1/stderr.log"
c1_exit=$?
grep -q "SMOKE-C1" "$WORK/c1/last.md" 2>/dev/null
report "C1 exec create + --output-last-message" $((c1_exit || $?))

# --- C2: thread.started proof and resume identity ---------------------------
tid=$(head -1 "$WORK/c1/events.jsonl" 2>/dev/null | grep -oE '"thread_id":"[^"]+"' | cut -d'"' -f4)
[ -n "$tid" ]
report "C2a first stdout line is thread.started" $? "$tid"
if [ -n "$tid" ]; then
  printf 'Reply with a final message of exactly: SMOKE-C2' \
    | native_shape "$WORK/c1/project" "$WORK/c1/resume.md" resume "$tid" \
    > "$WORK/c1/resume-events.jsonl" 2>/dev/null
  rid=$(head -1 "$WORK/c1/resume-events.jsonl" | grep -oE '"thread_id":"[^"]+"' | cut -d'"' -f4)
  [ "$rid" = "$tid" ]
  report "C2b resume re-emits the same thread id" $?
fi

# --- C3: non-Git project directory + --add-dir ------------------------------
mkdir -p "$WORK/c3/project" "$WORK/c3/extra" "$WORK/c3/home"
export CODEX_HOME="$WORK/c3/home"
cp ~/.codex/auth.json "$CODEX_HOME/auth.json" 2>/dev/null
cat > "$WORK/c3/extra/AGENTS.md" <<'INSTRUCTIONS'
For work in this directory, write the exact text EXTERNAL-AGENTS-C3 to wrote.txt.
INSTRUCTIONS
printf 'Before changing the additional task repository, inspect its applicable AGENTS.md.
Then use your shell tool to perform the requested change there.
Then reply with a final message of exactly: SMOKE-C3' \
  | native_shape "$WORK/c3/project" "$WORK/c3/last.md" --add-dir "$WORK/c3/extra" \
  > /dev/null 2>&1
grep -qx "EXTERNAL-AGENTS-C3" "$WORK/c3/extra/wrote.txt" 2>/dev/null
report "C3 --add-dir + explicit repository instructions" $?

# --- C4: native environment policy at the tool-command layer ----------------
# Allowlisted synthetic variables only: a full env dump would ship real
# credentials into the model context and the provider. Production hcom does
# not override this policy; put it in the disposable native config so the
# probe simultaneously verifies that user config is loaded.
mkdir -p "$WORK/c4/project" "$WORK/c4/home"
export CODEX_HOME="$WORK/c4/home"
cp ~/.codex/auth.json "$CODEX_HOME/auth.json" 2>/dev/null
cat > "$CODEX_HOME/config.toml" <<'CONFIG'
[shell_environment_policy]
inherit = "all"
ignore_default_excludes = true
CONFIG
cat > "$WORK/c4/project/probe.sh" <<'PROBE'
#!/bin/sh
{
  printf 'SECRETSHAPED=%s\n' "$SMOKE_SYNTH_TOKEN_VALUE"
  printf 'CASE_low=%s\n' "$smoke_case"
  printf 'CASE_UP=%s\n' "$SMOKE_CASE"
  printf 'EMPTY=[%s]\n' "$SMOKE_EMPTY"
  printf 'PROXY=%s\n' "$smoke_proxy"
} > probe.txt
PROBE
export SMOKE_SYNTH_TOKEN_VALUE=synthtok-smoke-abcdef
export smoke_case=lower-value SMOKE_CASE=UPPER-VALUE SMOKE_EMPTY=
export smoke_proxy=http://proxy.invalid:8080
printf 'Use your shell tool to run: sh probe.sh
Then reply with a final message of exactly: SMOKE-C4' \
  | native_shape "$WORK/c4/project" "$WORK/c4/last.md" >"$WORK/c4/events.jsonl" 2>/dev/null
probe=$(cat "$WORK/c4/project/probe.txt" 2>/dev/null)
ok=0
grep -q "SECRETSHAPED=synthtok-smoke-abcdef" <<<"$probe" || ok=1
grep -q "CASE_low=lower-value" <<<"$probe" || ok=1
grep -q "CASE_UP=UPPER-VALUE" <<<"$probe" || ok=1
grep -q "EMPTY=\[\]" <<<"$probe" || ok=1
grep -q "PROXY=http://proxy.invalid:8080" <<<"$probe" || ok=1
report "C4 native config controls tool environment" $ok

# --- C4b: the same environment survives a resume ----------------------------
tid4=$(head -1 "$WORK/c4/events.jsonl" 2>/dev/null | grep -oE '"thread_id":"[^"]+"' | cut -d'"' -f4)
if [ -n "$tid4" ]; then
  rm -f "$WORK/c4/project/probe.txt"
  printf 'Use your shell tool to run: sh probe.sh
Then reply with a final message of exactly: SMOKE-C4B' \
    | native_shape "$WORK/c4/project" "$WORK/c4/resume.md" resume "$tid4" >/dev/null 2>&1
  probe=$(cat "$WORK/c4/project/probe.txt" 2>/dev/null)
  grep -q "SECRETSHAPED=synthtok-smoke-abcdef" <<<"$probe"
  report "C4b env survives exec resume" $?
else
  report "C4b env survives exec resume" 1 "no thread id from C4"
fi

# --- C5: native global/project instructions are both loaded -----------------
mkdir -p "$WORK/c5/project" "$WORK/c5/home"
export CODEX_HOME="$WORK/c5/home"
cp ~/.codex/auth.json "$CODEX_HOME/auth.json" 2>/dev/null
cat > "$CODEX_HOME/AGENTS.md" <<'INSTRUCTIONS'
Every final answer must include the exact marker GLOBAL-INSTRUCTION-C5.
INSTRUCTIONS
cat > "$WORK/c5/project/AGENTS.md" <<'INSTRUCTIONS'
Every final answer must include the exact marker PROJECT-INSTRUCTION-C5.
INSTRUCTIONS
printf 'Reply briefly and include SMOKE-C5 while following all loaded instructions.' \
  | native_shape "$WORK/c5/project" "$WORK/c5/last.md" >/dev/null 2>&1
c5=0
grep -q "SMOKE-C5" "$WORK/c5/last.md" 2>/dev/null || c5=1
grep -q "GLOBAL-INSTRUCTION-C5" "$WORK/c5/last.md" 2>/dev/null || c5=1
grep -q "PROJECT-INSTRUCTION-C5" "$WORK/c5/last.md" 2>/dev/null || c5=1
report "C5 native global + project AGENTS.md" $c5

# --- C6: native CODEX_HOME receives the normal session record ---------------
sessions=$(find "$WORK/c1/home/sessions" -name 'rollout-*.jsonl' 2>/dev/null | wc -l)
[ "$sessions" -ge 1 ]
report "C6 native session store" $? "rollout files: $sessions"

printf '\n%d passed, %d failed\n' "$pass" "$fail"
if [ "$fail" -ne 0 ]; then
  exit 1
fi
exit 0
